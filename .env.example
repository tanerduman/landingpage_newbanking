FREECURRENCYAPI_KEY=
COLLECTAPI_KEY=
WAITLIST_USER=
WAITLIST_PASSWORD=
WAITLIST_SESSION_SECRET=
APP_URL=https://www.getaure.org
# Confirmation mail for a new package request and a support request.
# Verify getaure.org in Resend, then set MAIL_FROM to an address on that domain.
# Until the domain is verified, onboarding@resend.dev only reaches the Resend account address.
RESEND_API_KEY=
MAIL_FROM=AURE <noreply@getaure.org>
# 1 closes the site onto /maintenance. 0 or empty leaves it open. Redeploy after changing it on Vercel.
MAINTENANCE=0

